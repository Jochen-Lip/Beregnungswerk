                    "text": {
                        "de": "Zeitsteuerung für die automatische Bewässerung ein- und ausschalten.",
                        "en": "Enable or disable timed automatic irrigation."
                    },
                    "sm": 12
                },
                "schleifeAktiv": {
                    "type": "checkbox",
                    "label": {
                        "de": "Zeitsteuerung",
                        "en": "Time control"
                    },
                    "sm": 12,
                    "default": false
                },
                "timeEvents": {
                    "type": "table",
                    "sm": 12,
                    "clone": true,
                    "showSecondAddAt": 9999,
                    "items": [
                        {
                            "type": "text",
                            "attr": "_nr",
                            "title": {
                                "en": "No.",
                                "de": "Nr"
                            },
                            "readOnly": true,
                            "width": 40,
                            "doNotSave": true,
                            "defaultFunc": "return String(arrayIndex + 1);"
                        },
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": {
                                "en": "Active",
                                "de": "Aktiv"
                            },
                            "width": 56,
                            "default": false
                        },
                        {
                            "type": "text",
                            "attr": "zeit",
                            "title": {
                                "en": "Next switch",
                                "de": "Nächste Zeitschalt"
                            },
                            "width": 170,
                            "defaultFunc": "return '';"
                        },
                        {
                            "type": "text",
                            "attr": "wochentag",
                            "title": {
                                "en": "Weekdays/Holidays",
                                "de": "Wochentage/Feiertage"
                            },
                            "width": 380,
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "astroEin",
                            "title": {
                                "en": "Active",
                                "de": "Aktiv"
                            },
                            "width": 56,
                            "default": false
                        },
                        {
                            "type": "text",
                            "attr": "astro",
                            "title": {
                                "en": "Astro time switch",
                                "de": "Astrozeitschaltuhr"
                            },
                            "width": 0,
                            "default": ""
                        }
                    ]
                }
            }
        },
