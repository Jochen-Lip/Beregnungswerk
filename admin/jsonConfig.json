{
    "type": "tabs",
    "i18n": true,
    "iconPosition": "top",
    "tabsStyle": {
        "backgroundColor": "transparent",
        "minHeight": 96,
        "alignItems": "flex-end",
        "boxSizing": "border-box",
        "backgroundImage": "linear-gradient(180deg, rgba(0, 52, 26, 0.32) 0%, rgba(0, 28, 14, 0.08) 48%, rgba(0, 28, 14, 0.58) 82%, rgba(0, 28, 14, 0.72) 100%), url(adapter/beregnungswerk/gras-hintergrund.png)",
        "backgroundSize": "cover",
        "backgroundPosition": "center bottom",
        "backgroundRepeat": "no-repeat",
        "color": "#e0e0e0"
    },
    "items": {
        "tabSettings": {
            "type": "panel",
            "icon": "data:image/svg+xml;base64,",
            "label": {
                "en": "Valve selection",
                "de": "Ventilauswahl"
            },
            "items": {
                "_tabLayoutCss": {
                    "type": "iframe",
                    "url": "./adapter/beregnungswerk/tab-layout-inject.html?v=1562",
                    "sandbox":
                     "allow-same-origin allow-scripts",
                    "style": {
                        "height": 0,
                        "width": 0,
                        "border": "none",
                        "opacity": 0,
                        "position": "absolute",
                        "pointerEvents": "none"
                    },
                    "sm": 12
                },
                "_hVentile": {
                    "type": "header",
                    "text": {
                        "de": "Ventilauswahl",
                        "en": "Valve selection"
                    },
                    "size": 4,
                    "sm": 12
                },
                "_infoEventsDp": {
                    "type": "staticText",
                    "text": {
                        "de": "Magnetventile und Aktoren per Objekt-ID zuordnen. Stift öffnet Inline-Panel (Bewässerung & Schwellen je Ventil). Grün wird bewässert. Rot wird nicht bewässert. Weiß bewässert ohne Schwelle. Orange = Wartung/Rep.",
                        "en": "Assign valves via object ID. Pencil opens inline panel (irrigation & thresholds per valve). Green is watered. Red is not watered. White waters without a threshold. Orange = maintenance/repair."
                    },
                    "sm": 12
                },
                "ventilModus": {
                    "type": "checkbox",
                    "label": {
                        "de": "Manuall/Zeitsteuerung",
                        "en": "Manuall/Zeitsteuerung"
                    },
                    "sm": 12,
                    "default": false
                },
                "events": {
                    "type": "table",
                    "sm": 12,
                    "clone": true,
                    "showSecondAddAt": 9999,
                    "items": [
                        {
                            "type": "text",
                            "attr": "_nr",
                            "title": {
                                "en": "No.",
                                "de": "Nr"
                            },
                            "readOnly": true,
                            "width": 44,
                            "doNotSave": true,
                            "defaultFunc": "return '';"
                        },
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": {
                                "en": "Active",
                                "de": "Aktiv"
                            },
                            "width": 56,
                            "default": false
                        },
                        {
                            "type": "text",
                            "attr": "sprinkleName",
                            "title": {
                                "en": "Name",
                                "de": "Name"
                            },
                            "width": "18%",
                            "defaultFunc": "return 'Ventil' + (arrayIndex + 1);"
                        },
                        {
                            "type": "objectId",
                            "attr": "name",
                            "title": {
                                "en": "Object ID (output)",
                                "de": "Objekt-ID (Ausgang)"
                            },
                            "defaultFunc": "return 'beregnungswerk.0.Ventil' + (arrayIndex + 1);"
                        }
                    ]
                }
            }
        },
        "tabTimeSettings": {
            "type": "panel",
