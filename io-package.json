{
  "common": {
    "name": "beregnungswerk",
    "version": "0.2.0",
    "titleLang": {
      "en": "Beregnungswerk",
      "de": "Beregnungswerk"
    },
    "authors": [
      "Jochen Lip <jochen.lip@gmail.com>"
    ],
    "news": {
      "0.2.0": {
        "en": "Installable from GitHub. Messages can include pause, valve settings, astro, schedules, maintenance and a user-defined section.",
        "de": "Direkt von GitHub installierbar. Nachrichten können Pause, Ventil-Einstellungen, Astro, Schaltzeiten, Wartung und eine eigene Anzeige enthalten."
      },
      "0.1.0": {
        "en": "Fresh project: local dev-server, all data points under beregnungswerk.0, test hardware under beregnungswerk.0.Test",
        "de": "Neues Projekt: lokaler Dev-Server, alle Datenpunkte unter beregnungswerk.0, Test-Hardware unter beregnungswerk.0.Test"
      }
    },
    "desc": {
      "en": "Automatic irrigation for up to 4 valves: loop mode, weather data, cistern pump, notifications.",
      "de": "Automatische Bewässerung für bis zu 4 Ventile: Schleifenmodus, Wetterdaten, Brunnenpumpe, Nachrichten."
    },
    "keywords": [
      "Bewässerung",
      "Beregnung",
      "Garten",
      "Sprinkler",
      "Ventil"
    ],
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "platform": "Javascript/Node.js",
    "icon": "beregnungswerk.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/Jochen-Lip/beregnungswerk/main/admin/beregnungswerk.png",
    "readme": "https://github.com/Jochen-Lip/beregnungswerk/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "install": true,
    "type": "garden",
    "compact": false,
    "connectionType": "local",
    "dataSource": "push",
    "tier": 3,
    "dependencies": [
      {
        "js-controller": ">=5.7.3"
      },
      {
        "javascript": ">=5.0.0"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ],
    "adminUI": {
      "config": "json"
    },
    "localLinks": {
      "_default": {
        "link": "http://192.168.222.6:8082/vis-2/edit.html",
        "name": {
          "en": "VIS-2",
          "de": "VIS-2"
        }
      }
    }
  },
  "native": {
    "javascriptInstance": "javascript.0",
    "autoInstallJavascript": true,
    "autoEnableScript": true,
    "overwriteScript": true,
    "preferBuiltinEngine": true,
    "schleifeAktiv": false,
    "schleifePauseZwischenSek": 5,
