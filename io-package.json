    "gartenPumpeAusgang": "beregnungswerk.0.Test.Gartenpumpe",
    "ventile": [
      {
        "inSchleife": true,
        "dauer": 1,
        "wiederholungen": 2,
        "ausgang": "beregnungswerk.0.Ventil1",
        "feuchtSensor": "beregnungswerk.0.Test.luft",
        "tempSensor": "beregnungswerk.0.Test.temp",
        "schwelleVergleich": false,
        "schwelleFeuchtAktiv": false,
        "schwelleFeuchtWert": 40,
        "schwelleTempAktiv": false,
        "schwelleTempWert": 25
      }
    ],
    "events": [
