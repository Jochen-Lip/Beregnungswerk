    "tankPfadOben": "beregnungswerk.0.WassertankSteuerung.Anzeigen.Tank_oben_Soll",
    "tankPfadIstwert": "beregnungswerk.0.Test.TankIstwert",
    "tankBrunnenpumpe": "beregnungswerk.0.Test.Brunnenpumpe",
    "nachrichtenWhatsAppAktiv": false,
    "nachrichtenWhatsAppInstanz": "whatsapp-cmb.0",
    "nachrichtenTelegramAktiv": false,
